{
  "name": "ezacto-oss",
  "private": true,
  "version": "0.0.0",
  "description": "ezacto — open-source time tracking & invoicing. Pre-build: knowledge, specs, and pipeline scaffolding.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "entries/*",
    "apps/*"
  ],
  "scripts": {
    "contract:generate": "npm run build -w @ezacto/api && node scripts/generate-api-contract.mjs",
    "contract:check": "npm run build -w @ezacto/api && node scripts/generate-api-contract.mjs --check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:container": "node entries/container/test/first-run.docker.mjs",
    "build": "npm run build --workspaces --if-present",
    "verify": "npm run contract:check && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  }
}
