{
  "name": "ezacto-worker",
  "version": "0.0.0",
  "description": "Cloudflare Worker entry: the default deployment target.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --env dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run build -w @ezacto/web && wrangler deploy --env dev --dry-run --outdir dist",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:prod": "wrangler deploy --env prod"
  },
  "dependencies": {
    "@ezacto/api": "0.0.0",
    "@ezacto/db": "0.0.0",
    "@ezacto/integrations": "0.0.0",
    "@ezacto/mailer": "0.0.0",
    "@ezacto/web": "0.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.9.1",
    "jose": "^6.2.10",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1"
  }
}
