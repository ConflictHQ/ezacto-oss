{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ezacto",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",

  // Closed deliberately. The default *.workers.dev subdomain serves the SAME
  // worker with nothing in front of it — an unauthenticated side door past
  // whatever gates the custom domain. Every environment below keeps it shut.
  "workers_dev": false,
  "observability": { "enabled": true },

  // Two environments, on purpose: our books, and the one everyone else sees.
  // No per-branch preview workers — deploy targets are hosts we own and name.
  // The runtime reads a D1 binding named DB. API_CURSOR_SIGNING_KEY and AWS
  // credentials are Worker secrets; SES_REGION, SES_FROM, and the optional
  // SES_CONFIGURATION_SET are deployment vars. Environment-specific database
  // ids and Queue bindings are added only after actual resources are provisioned;
  // they are never fabricated in tracked config.
  "env": {
    // CONFLICT's own instance — the dogfood deployment, and the OSS gate.
    "prod": {
      "name": "ezacto",
      "routes": [{ "pattern": "app.example.com", "custom_domain": true }],
      "vars": { "ENVIRONMENT": "prod", "RELEASE": "unknown" },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "ezacto-prod",
        "database_id": "00000000-0000-0000-0000-000000000000"
      }],
      "workers_dev": false,
      "observability": { "enabled": true }
    },

    // The dev deployment, which becomes the public demo. Apex of the .io.
    "dev": {
      "name": "ezacto-dev",
      "routes": [{ "pattern": "ezacto.io", "custom_domain": true }],
      "vars": { "ENVIRONMENT": "dev", "RELEASE": "unknown" },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "ezacto-dev",
        "database_id": "00000000-0000-0000-0000-000000000000"
      }],
      "workers_dev": false,
      "observability": { "enabled": true }
    }
  }
}
