{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ezacto",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",

  // Closed deliberately. The default *.workers.dev subdomain serves the SAME
  // worker with nothing in front of it — an unauthenticated side door past
  // whatever gates the custom domain. Every environment below keeps it shut.
  "workers_dev": false,
  "observability": { "enabled": true },

  // Two environments, on purpose: our books, and the one everyone else sees.
  // No per-branch preview workers — deploy targets are hosts we own and name.
  // The runtime reads D1 as DB, R2 as ATTACHMENTS, and the mail producer as
  // EMAIL_QUEUE.
  // API_CURSOR_SIGNING_KEY and AWS credentials are Worker secrets. The optional
  // ACCESS_TEAM_DOMAIN/ACCESS_POLICY_AUD pair, SES_REGION, SES_FROM, and the
  // optional SES_CONFIGURATION_SET are deployment vars.
  // Queue and R2 names are the provisioning contract; the reviewed provision
  // workflows converge durable resources before this configuration is deployed.
  "env": {
    // CONFLICT's own instance — the dogfood deployment, and the OSS gate.
    "prod": {
      "name": "ezacto",
      "routes": [{ "pattern": "app.example.com", "custom_domain": true }],
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "ENVIRONMENT": "prod",
        "RELEASE": "unknown",
        "APP_BASE_URL": "https://app.example.com",
        // Deployment brand seam (#72). The install is CONFLICT's own, so the
        // shell, the sign-in gateway and outbound mail carry its name instead of
        // the product default. Wordmark and favicon are deliberately unset:
        // they take URLs, and the brand assets are not hosted yet, so the text
        // wordmark renders until they are.
        "BRAND_NAME": "CONFLICT",
        "BRAND_TAGLINE": "Time, exactly.",
        "BRAND_DESCRIPTION": "Time tracking and invoicing for CONFLICT LLC.",
        "BRAND_EMAIL_SENDER_NAME": "CONFLICT",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ezacto-prod",
          "database_id": "00000000-0000-0000-0000-000000000000",
        },
      ],
      "r2_buckets": [
        {
          "binding": "ATTACHMENTS",
          "bucket_name": "ezacto-prod-attachments",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "EMAIL_QUEUE",
            "queue": "ezacto-prod-email",
          },
        ],
        "consumers": [
          {
            "queue": "ezacto-prod-email",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 100,
            "retry_delay": 5,
            "dead_letter_queue": "ezacto-prod-email-dlq",
            "max_concurrency": 1,
          },
        ],
      },
      "workers_dev": false,
      "observability": { "enabled": true },
    },

    // The dev deployment, which becomes the public demo. Apex of the .io.
    "dev": {
      "name": "ezacto-dev",
      "routes": [{ "pattern": "ezacto.io", "custom_domain": true }],
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "ENVIRONMENT": "dev",
        "RELEASE": "unknown",
        "APP_BASE_URL": "https://ezacto.io",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ezacto-dev",
          "database_id": "00000000-0000-0000-0000-000000000000",
        },
      ],
      "r2_buckets": [
        {
          "binding": "ATTACHMENTS",
          "bucket_name": "ezacto-dev-attachments",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "EMAIL_QUEUE",
            "queue": "ezacto-dev-email",
          },
        ],
        "consumers": [
          {
            "queue": "ezacto-dev-email",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 100,
            "retry_delay": 5,
            "dead_letter_queue": "ezacto-dev-email-dlq",
            "max_concurrency": 1,
          },
        ],
      },
      "workers_dev": false,
      "observability": { "enabled": true },
    },
  },
}
