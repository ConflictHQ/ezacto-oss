{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "replace-me-worker-name",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",

  // Closed deliberately. The default *.workers.dev subdomain serves the SAME
  // worker with nothing in front of it — an unauthenticated side door past
  // whatever gates the custom domain. Every environment below keeps it shut.
  "workers_dev": false,
  "observability": { "enabled": true },

  // Two environments, on purpose: our books, and the one everyone else sees.
  // No per-branch preview workers — deploy targets are hosts we own and name.
  // The runtime reads D1 as DB, R2 as ATTACHMENTS, and the mail producer as
  // EMAIL_QUEUE.
  // API_CURSOR_SIGNING_KEY and AWS credentials are Worker secrets. The optional
  // ACCESS_TEAM_DOMAIN/ACCESS_POLICY_AUD pair, SES_REGION, SES_FROM, and the
  // optional SES_CONFIGURATION_SET are deployment vars.
  // Queue and R2 names are the provisioning contract; the reviewed provision
  // workflows converge durable resources before this configuration is deployed.
  "env": {
    // The operator's own instance -- whoever is running their books on this.
    // Every identifying value here is a placeholder: scripts/render-wrangler-prod.mjs
    // fills them from the deploying environment immediately before a prod
    // deploy. The placeholders are not valid Cloudflare identifiers, so a
    // deploy that skips the render is refused rather than pointed somewhere
    // unintended.
    "prod": {
      "name": "replace-me-worker-name",
      "routes": [{ "pattern": "replace-me.invalid", "custom_domain": true }],
      "triggers": { "crons": ["* * * * *", "0 3 * * *"] },
      "vars": {
        "ENVIRONMENT": "prod",
        "RELEASE": "unknown",
        "APP_BASE_URL": "https://replace-me.invalid",
        // Deployment brand seam (#72). A prod install carries the operator's
        // name through the shell, the sign-in gateway and outbound mail rather
        // than the product default. Wordmark and favicon are deliberately
        // unset: they take URLs, so the text wordmark renders until an operator
        // hosts assets of their own.
        "BRAND_NAME": "replace-me-brand-name",
        "BRAND_TAGLINE": "replace-me-brand-tagline",
        "BRAND_DESCRIPTION": "replace-me-brand-description",
        "BRAND_EMAIL_SENDER_NAME": "replace-me-brand-sender",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "replace-me-d1-name",
          "database_id": "00000000-0000-0000-0000-000000000000",
        },
      ],
      "r2_buckets": [
        {
          "binding": "ATTACHMENTS",
          "bucket_name": "replace-me-r2-bucket",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "EMAIL_QUEUE",
            "queue": "replace-me-email-queue",
          },
        ],
        "consumers": [
          {
            "queue": "replace-me-email-queue",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 100,
            "retry_delay": 5,
            "dead_letter_queue": "replace-me-email-queue-dlq",
            "max_concurrency": 1,
          },
        ],
      },
      "workers_dev": false,
      "observability": { "enabled": true },
    },

    // The dev deployment, which becomes the public demo. Apex of the .io.
    "dev": {
      "name": "ezacto-dev",
      "routes": [{ "pattern": "ezacto.io", "custom_domain": true }],
      "triggers": { "crons": ["* * * * *", "0 3 * * *"] },
      "vars": {
        "ENVIRONMENT": "dev",
        "RELEASE": "unknown",
        "APP_BASE_URL": "https://ezacto.io",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ezacto-dev",
          "database_id": "00000000-0000-0000-0000-000000000000",
        },
      ],
      "r2_buckets": [
        {
          "binding": "ATTACHMENTS",
          "bucket_name": "ezacto-dev-attachments",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "EMAIL_QUEUE",
            "queue": "ezacto-dev-email",
          },
        ],
        "consumers": [
          {
            "queue": "ezacto-dev-email",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 100,
            "retry_delay": 5,
            "dead_letter_queue": "ezacto-dev-email-dlq",
            "max_concurrency": 1,
          },
        ],
      },
      "workers_dev": false,
      "observability": { "enabled": true },
    },
  },
}
