# never track a local node_modules (a worktree symlink slipped in once)
/node_modules

# Generated at build time from shell.css and the browser modules. Committed, it
# was a 365KB blob on three lines that git cannot merge, so every branch
# touching the shell collided on it and every back-merge stopped: 43 of the last
# 150 merges on main resolved this one file by hand. The sibling generated files
# stay tracked -- they are small, readable, and they merge.
apps/web/src/generated/shell-assets.ts

# The Harvest snapshot: real client records, contact addresses and statement
# keys. The runbook builds it here by name (--snapshot-dir ./harvest-snapshot),
# so ignoring only "snapshot/" left the documented path tracked.
harvest-snapshot/
cutover.db
# The same records again, as SQL: the loader writes cutover.sql and the
# converter writes cutover.d1.sql beside it, both ~25 MB of live invoices.
cutover.sql
cutover.d1.sql

# Agent worktrees. Isolated checkouts created for parallel work: full copies of
# the repo, one `git add -A` away from being committed into it. Running vitest
# from the repo root also globs them, which runs every suite once per worktree
# against the same fixtures and fails them all on timeout.
.claude/worktrees/
