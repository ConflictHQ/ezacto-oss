{
  "name": "@ezacto/client",
  "version": "0.1.0",
  "description": "Generated TypeScript client for the ezacto native API (v1 contract).",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ConflictHQ/ezacto-oss.git",
    "directory": "packages/client"
  },
  "homepage": "https://ezacto.dev",
  "bugs": {
    "url": "https://github.com/ConflictHQ/ezacto-oss/issues"
  },
  "keywords": [
    "ezacto",
    "time-tracking",
    "invoicing",
    "api-client"
  ],
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
