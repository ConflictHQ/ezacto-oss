{
  "name": "@ezacto/db",
  "version": "0.0.0",
  "description": "Ezacto's shared Drizzle SQLite schema and D1/container adapters.",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./d1": {
      "types": "./src/d1.ts",
      "development": "./src/d1.ts",
      "default": "./dist/d1.js"
    },
    "./importer": {
      "types": "./src/importer.ts",
      "development": "./src/importer.ts",
      "default": "./dist/importer.js"
    },
    "./schema": "./dist/schema.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --testTimeout=30000",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ezacto/core": "0.0.0",
    "@noble/hashes": "2.4.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@eslint/js": "^10.0.1",
    "@ezacto/mailer": "0.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "eslint": "^10.9.1",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
