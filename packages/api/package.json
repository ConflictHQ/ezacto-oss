{
  "name": "@ezacto/api",
  "version": "0.0.0",
  "description": "Ezacto's runtime-portable Hono API chassis and serialization contract.",
  "type": "module",
  "files": ["dist", "src"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --testTimeout=20000",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ezacto/core": "0.0.0",
    "@ezacto/mailer": "0.0.0",
    "hono": "^4.13.5",
    "oauth4webapi": "^3.8.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.1",
    "better-sqlite3": "^13.0.3",
    "eslint": "^10.9.1",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
