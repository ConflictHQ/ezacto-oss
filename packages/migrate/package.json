{
  "name": "ezacto-migrate",
  "version": "0.0.0",
  "description": "Standalone CLI: extract a Harvest account into a snapshot, load it into ezacto, reconcile, sync.",
  "type": "module",
  "bin": {
    "ezacto-migrate": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --testTimeout=30000 --hookTimeout=30000",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ezacto/core": "0.0.0",
    "@ezacto/db": "0.0.0",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/better-sqlite3": "^7.6.13",
    "@cloudflare/workers-types": "^5.20260826.1",
    "eslint": "^10.9.1",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
