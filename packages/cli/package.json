{
  "name": "@ezacto/cli",
  "version": "0.0.0",
  "description": "ez — the native ezacto command-line client.",
  "type": "module",
  "bin": {
    "ez": "./dist/cli.js"
  },
  "files": ["dist", "src"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "npm run build -w @ezacto/client && npm run build",
    "test": "vitest run --testTimeout=10000",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ezacto/client": "0.0.0",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@ezacto/api": "0.0.0",
    "@ezacto/db": "0.0.0",
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "eslint": "^10.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
