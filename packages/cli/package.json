{
  "name": "@conflict-hq/ezacto-cli",
  "version": "0.1.0",
  "description": "ez \u2014 the native ezacto command-line client.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ConflictHQ/ezacto-oss.git",
    "directory": "packages/cli"
  },
  "homepage": "https://ezacto.dev",
  "bugs": {
    "url": "https://github.com/ConflictHQ/ezacto-oss/issues"
  },
  "keywords": [
    "ezacto",
    "time-tracking",
    "invoicing",
    "cli"
  ],
  "type": "module",
  "bin": {
    "ez": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "npm run build -w @conflict-hq/ezacto-client && npm run build",
    "test": "vitest run --testTimeout=10000",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@conflict-hq/ezacto-client": "^0.1.0",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@ezacto/api": "0.0.0",
    "@ezacto/db": "0.0.0",
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "eslint": "^10.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
