{
  "name": "@ezacto/mcp",
  "version": "0.0.0",
  "description": "Read-only Model Context Protocol server for ezacto.",
  "type": "module",
  "bin": {
    "ezacto-mcp": "./dist/cli.js"
  },
  "files": ["dist", "src", "README.md"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "npm run build -w @conflict-hq/ezacto-client && npm run build -w @conflict-hq/ezacto-cli && npm run build",
    "test": "vitest run --testTimeout=10000",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@conflict-hq/ezacto-cli": "^0.1.1",
    "@conflict-hq/ezacto-client": "^0.1.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@ezacto/api": "0.0.0",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.10.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
